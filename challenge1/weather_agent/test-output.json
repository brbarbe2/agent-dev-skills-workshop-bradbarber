{
  "model": "gemini-3.5-flash",
  "config": {
    "http_options": {},
    "system_instruction": "You are a weather agent designed to help a user get weather forcasts based on the city. Use the get_city_coordinates tool to     get the location of the city and use the get_nws_forcast tool to get the forcast\n\nYou are an agent. Your internal name is \"root_agent\". The description about you is \"Pat the friendly weather agent\".",
    "tools": [
      {
        "function_declarations": [
          {
            "description": "Converts a city name or address into latitude and longitude coordinates using Google Maps.\n\nArgs:\n    city_name: The name of the city (e.g., 'Paris, France', 'Tokyo, Japan').\n\nReturns:\n    A dictionary containing latitude, longitude, and formatted address,\n    or an error message if not found.",
            "name": "get_city_coordinates",
            "parameters_json_schema": {
              "properties": {
                "city_name": {
                  "title": "City Name",
                  "type": "string"
                }
              },
              "required": [
                "city_name"
              ],
              "title": "get_city_coordinatesParams",
              "type": "object"
            }
          },
          {
            "description": "Fetches the latest National Weather Service (NWS) forecast for given latitude and longitude coordinates.\nOnly supports locations within the United States.\n\nArgs:\n    latitude: Latitude in decimal degrees (e.g., 38.8894).\n    longitude: Longitude in decimal degrees (e.g., -77.0352).\n\nReturns:\n    A dictionary containing the current and upcoming forecast periods, \n    or an error message if the location is outside US coverage or unreachable.",
            "name": "get_nws_forecast",
            "parameters_json_schema": {
              "properties": {
                "latitude": {
                  "title": "Latitude",
                  "type": "number"
                },
                "longitude": {
                  "title": "Longitude",
                  "type": "number"
                }
              },
              "required": [
                "latitude",
                "longitude"
              ],
              "title": "get_nws_forecastParams",
              "type": "object"
            }
          }
        ]
      }
    ]
  },
